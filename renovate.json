{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":semanticCommits"],
  "minimumReleaseAge": "7 days",
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    { "matchManagers": ["gomod"], "groupName": "Go modules", "matchUpdateTypes": ["minor", "patch"] },
    { "matchManagers": ["npm"], "groupName": "web dependencies", "matchUpdateTypes": ["minor", "patch"] }
  ]
}
