---
// Starlight's ThemeProvider, except that with no choice stored the site is
// dark, like the app and the download page. "Auto" still follows the system.
import Default from "@astrojs/starlight/components/ThemeProvider.astro";
---

<script is:inline>
	try {
		if (!localStorage.getItem("starlight-theme")) localStorage.setItem("starlight-theme", "dark");
	} catch {}
</script>
<Default />
