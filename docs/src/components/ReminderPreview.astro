---
// A reminder as Telegram shows it: the layout and buttons of the first
// message in internal/actions/testdata/reminder_conversation.golden.
// Drawn in HTML so it stays sharp, themed and translatable.
const rows = [
	["✅ Already paid", "📅 Change date"],
	["💳 Payment method", "✏️ Amount"],
	["⏭ Skip this one", "❌ Cancel subscription"],
	["💤 Remind me tomorrow", "💤 In 3 days"],
];
---

<figure class="reminder not-content" aria-label="A reminder from Exhale in Telegram">
	<div class="chat">
		<div class="bubble">
			<p class="title">🔔 Netflix renews in 3 days</p>
			<p>💶 €13.99 · Sun, 8 Nov 2026</p>
			<p>💳 Revolut ••0937</p>
			<span class="time">09:00</span>
		</div>
		<div class="keys">
			{rows.map((row) => row.map((label) => <span class="key">{label}</span>))}
		</div>
	</div>
	<figcaption>A reminder in Telegram. Each button changes the subscription right there, and the message redraws with the result.</figcaption>
</figure>

<style>
	.reminder {
		margin: 2rem 0 0;
	}
	/* The real message's emoji, in the greys of the site. */
	.bubble,
	.key {
		font-variant-emoji: text;
	}
	.chat :is(.bubble p, .key) {
		filter: grayscale(1);
	}
	.chat {
		position: relative;
		display: grid;
		gap: 4px;
		width: min(100%, 25rem);
		margin-inline: auto;
		padding: 1.25rem 1rem;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 16px;
		background:
			radial-gradient(80% 60% at 50% 0%, oklch(0.8 0.1 250 / 0.14), transparent 70%),
			var(--sl-color-gray-6);
		font-size: 0.875rem;
		line-height: 1.45;
	}
	@media (min-width: 50rem) {
		.chat {
			width: auto;
			padding: 2.25rem calc(50% - 12.5rem);
		}
	}
	.bubble {
		position: relative;
		padding: 0.625rem 0.875rem 1.25rem;
		border-radius: 12px 12px 12px 4px;
		background: var(--sl-color-black);
		border: 1px solid var(--sl-color-hairline);
		color: var(--sl-color-white);
	}
	.bubble p {
		margin: 0;
		color: var(--sl-color-gray-2);
	}
	.bubble .title {
		color: var(--sl-color-white);
		font-weight: 600;
		margin-bottom: 0.25rem;
	}
	.time {
		position: absolute;
		right: 0.625rem;
		bottom: 0.375rem;
		font-size: 0.6875rem;
		color: var(--sl-color-gray-2);
	}
	.keys {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 4px;
	}
	.key {
		display: grid;
		place-items: center;
		min-height: 2.25rem;
		padding: 0.25rem 0.5rem;
		border-radius: 8px;
		background: color-mix(in oklch, var(--sl-color-black) 55%, transparent);
		border: 1px solid var(--sl-color-hairline);
		color: var(--sl-color-white);
		font-size: 0.8125rem;
		font-weight: 500;
		text-align: center;
	}
	@media (max-width: 30rem) {
		.key {
			font-size: 0.75rem;
		}
	}
	figcaption {
		margin-top: 0.75rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		text-align: center;
	}
</style>
