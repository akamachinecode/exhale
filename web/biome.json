{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"files": {
		"includes": ["src/**", "*.ts", "!src/gen"]
	},
	"formatter": {
		"indentStyle": "tab",
		"lineWidth": 110
	},
	"linter": {
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
