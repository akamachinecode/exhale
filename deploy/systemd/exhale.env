# Settings for the Exhale service (systemd reads this file).
# One NAME=value per line, no quotes needed, no "export".
# After a change: sudo systemctl restart exhale
#
# Every setting is also a flag of `exhale serve` (see `exhale serve --help`).

# Address to listen on. The default only answers on this machine.
# Use 0.0.0.0:8484 to reach it from your network, or keep the default and
# put a reverse proxy in front (docs/install/https.md).
#EXHALE_LISTEN=127.0.0.1:8484

# Set to true when people reach Exhale over HTTPS (reverse proxy, Tailscale
# Serve). Leave it off for plain http://, or nobody can sign in.
#EXHALE_SECURE_COOKIES=true

# Where the database lives. The service may only write to /var/lib/exhale;
# changing this needs a ReadWritePaths= drop-in (systemctl edit exhale).
#EXHALE_DATA_DIR=/var/lib/exhale

# Daily automatic backups: where (default: <data dir>/backups), how many to
# keep (default 14, 0 keeps all), or turn them off.
# A directory outside /var/lib/exhale needs a ReadWritePaths= drop-in.
#EXHALE_BACKUP_DIR=/var/lib/exhale/backups
#EXHALE_BACKUP_KEEP=14
#EXHALE_NO_BACKUPS=true

# Telegram bot token from @BotFather. Usually set from the web instead
# (Settings → Telegram); set here, it cannot be changed from the web.
#EXHALE_TELEGRAM_TOKEN=

# Logs go to the journal: journalctl -u exhale
#EXHALE_LOG_LEVEL=info
#EXHALE_LOG_FORMAT=text
