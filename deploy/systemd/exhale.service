# Exhale as a systemd service.
#
# Installed by the .deb/.rpm packages and by scripts/install.sh --service.
# Settings go in /etc/exhale/exhale.env; do not edit this file (a package
# upgrade replaces it). To change the unit itself: systemctl edit exhale
#
# Docs: https://github.com/akamachinecode/exhale/blob/main/docs/install/linux.md

[Unit]
Description=Exhale subscription manager
Documentation=https://github.com/akamachinecode/exhale/tree/main/docs/install
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exhale
Group=exhale
ExecStart=/usr/bin/exhale serve

# Data lives in /var/lib/exhale: systemd creates it, owned by the service
# user. Values in exhale.env override these two defaults.
StateDirectory=exhale
StateDirectoryMode=0750
WorkingDirectory=/var/lib/exhale
Environment=EXHALE_DATA_DIR=/var/lib/exhale
EnvironmentFile=-/etc/exhale/exhale.env

Restart=on-failure
RestartSec=5
# Exhale finishes within 8 s of SIGTERM.
TimeoutStopSec=15

# --- Sandbox -----------------------------------------------------------------
# The service can write only to /var/lib/exhale. To keep backups elsewhere,
# add the directory in a drop-in (systemctl edit exhale):
#   [Service]
#   ReadWritePaths=/mnt/backups/exhale
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# No capabilities: Exhale listens on a high port (8484). For port 443, put a
# reverse proxy in front (docs/install/https.md).
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
